# Для docker-compose-dev.yml: скопировать в .env рядом с ним, compose подхватит сам.

# === SoundCloud OAuth ===
SOUNDCLOUD_CLIENT_ID=your_client_id
SOUNDCLOUD_CLIENT_SECRET=your_client_secret
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/auth/callback

# === SoundCloud: прокси и куки ===
SC_PROXY_URL=
SC_PROXY_FALLBACK=false
SC_COOKIES=

# === Токены ===
ADMIN_TOKEN=dev
INTERNAL_TOKEN=dev-internal
STREAM_TICKET_KEY=
STREAM_TICKET_PREVIOUS_KEYS=

# === Пропускник публичных входов ===
ADMISSION_WINDOW_SECONDS=60
ADMISSION_TIMEOUT_MS=100
ADMISSION_MAX_IN_FLIGHT=16
AUTH_LOGIN_PER_CLIENT=15
AUTH_LOGIN_GLOBAL=300
AUTH_LINK_CREATE_PER_CLIENT=30
AUTH_LINK_CREATE_GLOBAL=600
RESOLVE_PER_CLIENT=60
RESOLVE_GLOBAL=1200

# === Живой поиск SoundCloud ===
SEARCH_LIVE_MODE=auto
SEARCH_LIVE_DB_RESCUE=false
SEARCH_LIVE_MAX_IN_FLIGHT=8
SEARCH_LIVE_MAIN_PER_CLIENT=10
SEARCH_LIVE_MAIN_GLOBAL=60
SEARCH_LIVE_SIDE_PER_CLIENT=6
SEARCH_LIVE_SIDE_GLOBAL=30
SEARCH_LIVE_IMPORT_PER_CLIENT=20
SEARCH_LIVE_IMPORT_GLOBAL=40
SEARCH_LIVE_RESCUE_PER_CLIENT=4
SEARCH_LIVE_RESCUE_GLOBAL=20
SEARCH_LIVE_PROXY_PER_CLIENT=20
SEARCH_LIVE_PROXY_GLOBAL=20
SEARCH_RANKED=true
ENTITY_MISS_INLINE=false
ENTITY_MISS_INLINE_PER_CLIENT=10
ENTITY_MISS_INLINE_GLOBAL=60

# === Storage ===
# STORAGE_PUBLIC_URL пустой — streaming отдаёт внутренний адрес.
# STORAGE_UPLOAD_URL пустой — запись идёт туда же, откуда чтение.
STORAGE_PUBLIC_URL=
STORAGE_UPLOAD_URL=
STORAGE_BACKEND=local
MAX_TRANSCODES=2
TRANSCODE_BATCH_SIZE=8
TRANSCODE_BATCH_WAIT_MS=50
UPLOAD_CONCURRENCY=64
UPLOAD_RETRIES=4
UPLOAD_RETRY_BASE_MS=250

# === S3, если STORAGE_BACKEND=s3 ===
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# === Streaming ===
PREMIUM_ONLY=false
STORAGE_CLEANUP_DAYS=7
STORAGE_MAX_SIZE_BYTES=0
STORAGE_CLEANUP_INTERVAL_SECS=3600

# === Worker ===
MINI_MODEL=google/gemma-4-E2B-it
WHISPER_MODEL=base
WHISPER_COMPUTE=int8

# === Genius ===
# Без токена api.genius.com отдаёт 401 и остаётся только web-scrape.
# Выписать: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# === Рекомендации ===
SOUNDWAVE_ARTIST_CAP=2
SOUNDWAVE_POPULARITY_BOOST=0.01
