server {
    listen 8080;
    client_max_body_size 128k;

    location = /chat/x {
        proxy_pass http://${CHAT_IT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
