server {
    listen 8080;
    client_max_body_size 128k;

    location /auth/ {
        proxy_pass http://${CHAT_IT_AUTH_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://${CHAT_IT_CHAT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
