+}
+
+async fn build_template(
+    conn: &mut PgConnection,
+    master_pool: &Pool<Postgres>,
+    migrator: &Migrator,
+    name: &str,
+) -> Result<(), Error> {
+    let exists: bool =
+        query_scalar("select exists (select 1 from pg_database where datname = $1)")
+            .bind(name)
+            .fetch_one(&mut *conn)
+            .await?;
+    if exists {
+        return Ok(());
+    }
+
+    let building = format!("{name}_building");
+    conn.execute(&*format!("drop database if exists {building:?}"))
+        .await?;
+    conn.execute(&*format!("create database {building:?}"))
+        .await?;
+
+    let options = master_pool.connect_options().deref().clone().database(&building);
+    let mut template = PgConnection::connect_with(&options).await?;
+    migrator.run_direct(&mut template).await?;
+    template.close().await?;
+
+    conn.execute(&*format!("alter database {building:?} rename to {name:?}"))
+        .await?;
+    Ok(())
+}
