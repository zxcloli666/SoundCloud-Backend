+async fn migrated_template(
+    conn: &mut PgConnection,
+    master_pool: &Pool<Postgres>,
+    migrator: &Migrator,
+) -> Result<String, Error> {
+    let mut hasher = Sha256::new();
+    for migration in migrator.iter() {
+        hasher.update(migration.version.to_le_bytes());
+        hasher.update(&*migration.checksum);
+    }
+    let mut name = String::from("_sqlx_template_");
+    for byte in &hasher.finalize()[..8] {
+        write!(name, "{byte:02x}").ok();
+    }
+
+    query("select pg_advisory_lock(hashtext($1))")
+        .bind(&name)
+        .execute(&mut *conn)
+        .await?;
+    let built = build_template(conn, master_pool, migrator, &name).await;
+    query("select pg_advisory_unlock(hashtext($1))")
+        .bind(&name)
